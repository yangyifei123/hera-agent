{
  "name": "hera-agent",
  "version": "2.2.0",
  "description": "Hera - Agent Factory: Creates agents with memory, distillation, skills, team collaboration, and self-evolution for OpenCode",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "hera": "./bin/hera.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && bun build src/index.ts --outdir dist --target bun --format esm --external @opencode-ai/plugin --external @opencode-ai/sdk && tsc -p tsconfig.build.json --emitDeclarationOnly --declaration --declarationMap --outDir dist && echo 'build done'",
    "prepublishOnly": "bun run typecheck && bun run lint && bun test && bun run build && npm pack --dry-run",
    "postinstall": "node postinstall.mjs",
    "dev": "bun run --watch src/index.ts",
    "test": "bun test",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "opencode",
    "agent",
    "ai",
    "llm",
    "agent-factory",
    "multi-agent",
    "team-collaboration",
    "self-evolution",
    "memory",
    "skills"
  ],
  "author": "Yang Yifei",
  "dependencies": {
    "@opencode-ai/plugin": "^1.4.6",
    "@types/tar-fs": "^2.0.4",
    "tar-fs": "^3.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.2.0",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.3",
    "typescript": "^5.7.0"
  },
  "files": [
    "dist",
    "bin",
    "postinstall.mjs",
    "hera.schema.json",
    "hera.example.json",
    "docs/INSTALLATION.md",
    "docs/CANONICAL_DEMO.md",
    "docs/INSTALLATION_RISK_MATRIX.md",
    "docs/INSTALLATION_MATRIX.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/yangyifei123/hera-agent.git"
  },
  "bugs": {
    "url": "https://github.com/yangyifei123/hera-agent/issues"
  },
  "homepage": "https://github.com/yangyifei123/hera-agent#readme",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
