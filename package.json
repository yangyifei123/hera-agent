{
  "name": "hera-agent",
  "version": "2.2.0",
  "description": "Hera - Agent Factory: Creates agents with memory, distillation, skills, team collaboration, and self-evolution for OpenCode",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "hera": "./bin/hera.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun --format esm --external @opencode-ai/plugin --external @opencode-ai/sdk && echo 'build done'",
    "postinstall": "node postinstall.mjs",
    "dev": "bun run --watch src/index.ts",
    "test": "bun test"
  },
  "keywords": [
    "opencode",
    "agent",
    "ai",
    "llm",
    "agent-factory",
    "multi-agent",
    "team-collaboration",
    "self-evolution",
    "memory",
    "skills"
  ],
  "author": "Yang Yifei",
  "dependencies": {
    "@opencode-ai/plugin": "^1.4.6"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/bun": "^1.2.0"
  },
  "files": [
    "dist",
    "bin",
    "postinstall.mjs",
    "hera.schema.json",
    "hera.example.json"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/yangyifei123/hera-agent.git"
  },
  "bugs": {
    "url": "https://github.com/yangyifei123/hera-agent/issues"
  },
  "homepage": "https://github.com/yangyifei123/hera-agent#readme",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  }
}
